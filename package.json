{
  "name": "ai-usage-audit",
  "version": "0.1.1",
  "description": "Read-only CLI that analyzes your local Claude Code transcripts and shows where your tokens go. No network, no dependencies.",
  "type": "module",
  "bin": {
    "ai-usage-audit": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild analyze.ts --platform=node --format=esm --target=node18 --outfile=dist/analyze.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node --experimental-strip-types analyze.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "tokens",
    "usage",
    "cli",
    "audit"
  ],
  "author": "Artem Horobchenko <artemhorobchenko@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
